definition
	CLUSTER[at0000] matches {    -- Diagnosis category
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Childhood illness
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Pregnancy related
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Oncological
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Psychiatric
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Preoperative
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Discharge
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Admission
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Postoperative
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0009] occurrences matches {0..1} matches {    -- Psychological
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Self-reported
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
		}
	}

