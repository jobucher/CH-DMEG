definition
	CLUSTER[at0000] matches {    -- diagnostic_process_context_ch
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Admission diagnosis
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0011,    -- Yes
							at0012]    -- No
						}
					}
				}
			}
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Preoperative diagnosis
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Yes
							at0003]    -- No
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Postoperative diagnosis
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0005,    -- Yes
							at0006]    -- No
						}
					}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Discharge diagnosis
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0008,    -- Yes
							at0009]    -- No
						}
					}
				}
			}
		}
	}

