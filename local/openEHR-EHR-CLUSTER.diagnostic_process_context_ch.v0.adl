definition
	CLUSTER[at0000] matches {    -- Diagnostic process context
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- Diagnostic event
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0014,    -- Admitting diagnosis
							at0015,    -- Final diagnosis (discharge)
							at0016,    -- Post-op diagnosis
							at0017,    -- Pre-op diagnosis
							at0018,    -- Transfer diagnosis
							at0019]    -- Referral diagnosis
						}
					}
				}
			}
		}
	}

